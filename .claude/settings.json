{
  "permissions": {
    "allow": [
      "Bash(npx playwright test*)",
      "Bash(npx playwright show-report*)",
      "Bash(npx playwright install*)",
      "Bash(npm run *)",
      "Bash(npx tsc --noEmit*)"
    ],
    "deny": [
      "Bash(git push* main)",
      "Bash(git push* master)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Bash(rm -rf*)"
    ]
  }
}
